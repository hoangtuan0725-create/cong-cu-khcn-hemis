{
  "manifest_version": 3,
  "name": "Công cụ KHCN TLU → HEMIS",
  "version": "1.2.0",
  "description": "Quét bài báo trên KHCN TLU, đẩy lên HEMIS, thống kê dữ liệu KHCN và chỉ số Chuẩn CSGDĐH (Phòng KHCN&HTQT).",
  "action": {
    "default_title": "Mở công cụ KHCN TLU → HEMIS",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://khcn.tlu.edu.vn/*",
    "https://hemis-cms.moet.gov.vn/*",
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}