{
  "manifest_version": 3,
  "name": "Công cụ KHCN TLU → HEMIS",
  "version": "2.0.0",
  "description": "Cầu nối cho trang Công cụ KHCN TLU → HEMIS: lấy dữ liệu KHCN và HEMIS bằng phiên đăng nhập sẵn có của người dùng.",
  "action": {
    "default_title": "Mở công cụ KHCN TLU → HEMIS",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://khcn.tlu.edu.vn/*",
    "https://hemis-cms.moet.gov.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://hoangtuan0725-create.github.io/cong-cu-khcn-hemis/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
